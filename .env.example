# Postgres from the shared yp/database stack (db-network).
# When running this app in Docker on db-network, use host "db-postgres".
# When running it directly on the host, use "localhost" instead.
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/app

# Gmail API (OAuth "Desktop app" credentials from Google Cloud Console).
GMAIL_CREDENTIALS_FILE=credentials/credentials.json
GMAIL_TOKEN_FILE=credentials/token.json
# Gmail search query used to pick which inbox messages are articles.
GMAIL_QUERY=in:inbox is:unread
# Remove the UNREAD label on Gmail after an article is ingested.
GMAIL_MARK_AS_READ=true

# Anthropic Claude API, used to summarize + translate each article.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TARGET_LANGUAGE=English
